# ===================================================================
# QuickCourt — Environment Configuration Example (.env.example)
# ===================================================================
# Copy this file to .env or set these environment variables in your deployment / terminal.
# NEVER commit your real secrets to version control.
# ===================================================================

# Application Server
PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Razorpay Payment Gateway (Test Mode Credentials)
# Obtain these from: https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=YourKeySecretHere
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretHere

# Booking Temporary Hold Duration (in minutes)
BOOKING_HOLD_MINUTES=10

# Database Configuration (Defaults to persistent file H2 at ~/.quickcourt/quickcourt.mv.db if SPRING_PROFILES_ACTIVE=dev)
# For MySQL: set SPRING_PROFILES_ACTIVE=mysql and supply credentials below:
# DB_URL=jdbc:mysql://localhost:3306/quickcourt?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
# DB_USER=root
# DB_PASSWORD=your_mysql_password

# Security & JWT Configuration
# Required: supply a secure random string of at least 32 characters (256 bits).
# Generate one using: openssl rand -hex 32  OR  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Note: Previously exposed dev secret '404E6352...' has been rotated and invalidated.
JWT_SECRET=replace_with_your_secure_random_key_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Default Admin Seed Configuration
ADMIN_EMAIL=admin@quickcourt.com
ADMIN_PASSWORD=Admin@123
